{
  "name": "galyaszferenc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal site of Ferenc Gályász.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "astro check",
    "deploy": "npm run build && wrangler pages deploy dist --project-name galyaszferenc",
    "db:migrate": "wrangler d1 execute galyaszferenc-contact --remote --file schema/contact.sql"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/outfit": "^5.2.8",
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
