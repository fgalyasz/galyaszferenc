---
import Base from "../layouts/Base.astro";
import { SONGS } from "../data/songs";
---

<Base
  title="Dalaim"
  description="Gályász Ferenc saját dalai. A szöveget és a zenét is ő írja, és maga adja elő."
>
  <article class="page">
    <header class="page-head">
      <p class="index">04 — Dalaim</p>
      <h1>A saját darabok.</h1>
      <p class="lede">
        A dalszöveget és a zenét is én írom, és magam adom elő. A szövegek az életem napi történésein alapulnak.
      </p>
    </header>
    {
      SONGS.length === 0 ? (
        <section class="card">
          <p class="meta">Katalógus</p>
          <h2>Még nincs kiadott cím ezen az oldalon.</h2>
          <p>
            A címek ide kerülnek. A dalok a napi életen alapulnak, a szerzés módja a zeneszerzés lapon olvasható.
          </p>
        </section>
      ) : (
        <div class="score">
          {SONGS.map((song) => (
            <section class="movement">
              <p class="meta">Dal</p>
              <div>
                <h2>{song.title}</h2>
                <p>{song.note}</p>
              </div>
            </section>
          ))}
        </div>
      )
    }
  </article>
</Base>
