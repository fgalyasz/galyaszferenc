---
import Base from "../layouts/Base.astro";
import { MOVEMENTS } from "../data/songs";
---

<Base
  title="Zeneszerzéshez használt technikáim"
  description="A Vocal Alchemist pipeline: énekizolálás, formánst tartó hangmagasság, self-SVC és hangszerelés."
>
  <article class="page">
    <header class="page-head">
      <p class="index">02 — Zeneszerzés</p>
      <h1>A darab a tiszta éneken áll.</h1>
      <p class="lede">
        Nem kész loopra énekelek rá. Előbb a saját hangot teszem rendbe, és a kíséret ahhoz igazodik.
      </p>
    </header>
    <div class="score">
      {
        MOVEMENTS.map((movement) => (
          <section class="movement">
            <p class="meta">{movement.index}</p>
            <div>
              <h2>{movement.title}</h2>
              <p>{movement.text}</p>
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>
