---
import Base from "../layouts/Base.astro";
import { MOVEMENTS } from "../data/songs";
---

<Base
  title="Zeneszerzéshez használt technikáim"
  description="Gitár, furulya és szintetizátor. Gályász Ferenc írja a szöveget, a zenét, és maga adja elő."
>
  <article class="page">
    <header class="page-head">
      <p class="index">02 — Zeneszerzés</p>
      <h1>A zene születésem óta velem van.</h1>
      <p class="lede">
        Gitárral kezdődött, furulyával folytatódott, szintetizátoron érkezik meg a dal. A szöveget, a zenét és az előadást is én viszem.
      </p>
    </header>
    <div class="score">
      {
        MOVEMENTS.map((movement) => (
          <section class="movement">
            <p class="meta">{movement.index}</p>
            <div>
              <h2>{movement.title}</h2>
              <p>{movement.text}</p>
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>
