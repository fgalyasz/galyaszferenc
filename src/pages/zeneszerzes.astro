---
import Base from "../layouts/Base.astro";
import { MOVEMENTS } from "../data/songs";
---

<Base
  title="Zeneszerzéshez használt technikáim"
  description="Dallam, szöveg, kíséret és a felvétel hangzása. Gályász Ferenc zeneszerzési gyakorlata."
>
  <article class="page">
    <header class="page-head">
      <p class="index">02 — Zeneszerzés</p>
      <h1>A dal a dallamon áll.</h1>
      <p class="lede">
        Előbb a dallam és a szöveg, utána a kíséret, végül a hangzás, amin a darab megszólal.
      </p>
    </header>
    <div class="score">
      {
        MOVEMENTS.map((movement) => (
          <section class="movement">
            <p class="meta">{movement.index}</p>
            <div>
              <h2>{movement.title}</h2>
              <p>{movement.text}</p>
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>
